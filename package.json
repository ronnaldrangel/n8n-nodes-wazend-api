{
  "name": "n8n-nodes-wazend-api",
  "version": "0.1.0",
  "description": "Wazend API nodes for WhatsApp messaging and webhook events in n8n",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://wazend.net",
  "author": {
    "name": "Wazend",
    "email": "ronnaldrangel@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ronnaldrangel/n8n-nodes-wazend-api.git"
  },
  "moduleDirectories": [
    "node_modules",
    "src"
  ],
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "test": "jest --runInBand",
    "test:sync": "node scripts/sync.test.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "lint": "eslint nodes credentials package.json",
    "prepublishOnly": "npm run check:branding && npm test && npm run build"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WazendApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Wazend/Wazend.node.js",
      "dist/nodes/Wazend/WazendTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.5.5",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-core": "*",
    "n8n-workflow": "*",
    "prettier": "^2.7.1",
    "ts-jest": "^29.2.5",
    "typescript": "~4.8.4"
  },
  "dependencies": {
    "@devlikeapro/n8n-openapi-node": "^0.1.4",
    "lodash": "^4.17.21",
    "openapi-types": "^12.1.3",
    "pino": "^9.4.0"
  },
  "bugs": {
    "url": "https://github.com/ronnaldrangel/n8n-nodes-wazend-api/issues"
  }
}
